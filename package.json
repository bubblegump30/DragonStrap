{
  "name": "dragonstrap",
  "productName": "DragonStrap",
  "version": "1.0.0",
  "private": true,
  "description": "DragonStrap stable Windows Roblox bootstrapper and launcher with Purple Dragon UI, Launch Center, Performance+, FastFlag management, Server Intelligence, Studio tools, channel tracking, repair, diagnostics, and release update checking",
  "main": "main.js",
  "author": "DragonStrap Project",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check-source.js",
    "test": "node --test tests/*.test.js",
    "release:prepare": "node scripts/prepare-release.js",
    "release:verify": "node scripts/verify-release.js",
    "pack:win": "npm run release:verify && electron-builder --win --x64 --dir",
    "dist:win": "npm run release:verify && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.dragonstrap.app",
    "productName": "DragonStrap",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "release.config.json",
      "VERSION",
      "THIRD_PARTY_NOTICES.md",
      "renderer/**/*",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/DragonStrap.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "DragonStrap-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DragonStrap-Portable-${version}-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bubblegump30/DragonStrap.git"
  },
  "homepage": "https://github.com/bubblegump30/DragonStrap",
  "bugs": {
    "url": "https://github.com/bubblegump30/DragonStrap/issues"
  }
}
